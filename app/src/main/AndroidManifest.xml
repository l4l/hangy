<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The WH-C06 is read via BLE advertisement scanning only (no GATT connection),
      so BLUETOOTH_SCAN with neverForLocation is the only Bluetooth permission needed
      on minSdk 31+. We never derive physical location from BLE results.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!--
      The Bluetooth stack clamps a scan to SCAN_MODE_LOW_POWER unless the app's UID importance is
      at least IMPORTANCE_FOREGROUND_SERVICE, which collapses the live reading rate. ScaleService
      runs as a connectedDevice foreground service for the length of a session to hold that
      importance; a granted BLUETOOTH_SCAN satisfies the type's prerequisite permission.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Denying this hides the service's notification; the scan still runs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:name=".HangyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hangy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Hangy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".session.ScaleService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
